    "show": "node tools/show.js",
    "test:build": "node test/build.js",
    "audit": "node tools/audit.js --check",
    "site": "node tools/site.js",
    "pictures": "node test/pictures.js",
    "clean": "node tools/clean.js"
  },
  "devDependencies": {
    "@fontsource/courier-prime": "5.3.0",
